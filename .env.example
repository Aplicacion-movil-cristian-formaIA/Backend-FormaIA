# === Servidor HTTP ===
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
EVENT_WORKER_THREADS=4

# === Base de datos (XAMPP / MySQL o MariaDB) ===
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=formaia
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=8

# === Groq (IA) ===
# Crea tu clave en https://console.groq.com
GROQ_API_KEY=coloca_aqui_tu_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_HOST=api.groq.com
GROQ_TIMEOUT_MS=20000

# === Seguridad ===
# Clave maestra para cifrado de campos sensibles (AES-256-GCM), 32 bytes en base64.
# NUNCA subas la clave real a un repositorio; en producción usa un KMS.
FIELD_ENCRYPTION_KEY_BASE64=coloca_aqui_una_clave_de_32_bytes_en_base64
JWT_SECRET=coloca_aqui_un_secreto_largo_y_aleatorio
